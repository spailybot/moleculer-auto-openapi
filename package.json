{
  "name": "@spailybot/moleculer-auto-openapi",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "version": "2.0.0",
  "description": "Generate openapi scheme for moleculer",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "prepack": "npm run build",
    "version": "npm run build",
    "preversion": "git update-index --really-refresh && git diff-index --quiet HEAD || (echo git is not clean && exit 1)",
    "ts-types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir lib/types",
    "build": "rimraf lib && node esbuild.mjs && npm run ts-types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**\"",
    "lint:fix": "npm run lint -- --fix",
    "ci:eslint": "npm run lint -- -f json -o ./coverage/eslint-report.json",
    "generate:documentation": "typedoc"
  },
  "files": [
    "lib",
    "index.d.ts"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      },
      "default": "./lib/index.cjs"
    },
    "./types": {
      "types": "./index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spailybot/moleculer-auto-openapi.git"
  },
  "keywords": [
    "openapi",
    "openapi 3.1",
    "fastest-validator",
    "swagger",
    "moleculer",
    "moleculer-web"
  ],
  "author": "SpailyBot <contact@sbot.tv>",
  "contributors": [
    "Gabdrashitov Rinat <paladin2012gnu@gmail.com>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spailybot/moleculer-auto-openapi/issues"
  },
  "homepage": "https://github.com/spailybot/moleculer-auto-openapi#readme",
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.9.1",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/body-parser": "^1.19.6",
    "@types/node": "^26.2.0",
    "@types/qs": "^6.15.1",
    "@types/semver": "^7.8.0",
    "@types/swagger-ui-dist": "^3.30.6",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "fastest-validator": "^1.19.1",
    "moleculer": "^0.15.0",
    "moleculer-web": "^0.11.0",
    "openapi-types": "^12.1.3",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "swagger-ui-dist": "^5.10.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "moleculer": "^0.15.0"
  },
  "optionalDependencies": {
    "swagger-ui-dist": "^5.32.13"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
